diff --git a/phpdocker/php-fpm/php-ini-overrides.ini b/phpdocker/php-fpm/php-ini-overrides.ini
index c35f34e7..19ad9495 100644
--- a/phpdocker/php-fpm/php-ini-overrides.ini
+++ b/phpdocker/php-fpm/php-ini-overrides.ini
@@ -4,6 +4,12 @@ memory_limit = 200M
 display_errors = On
 max_execution_time = 600
 
+# gamemaster.php is polled every 3s by gamemaster-entrypoint.sh; with validate_timestamps on,
+# concurrent FPM workers race to revalidate/recompile the same files, causing intermittent
+# Cannot redeclare Misc::write fatals. Disable timestamp revalidation to remove the race.
+# Restart php-fpm after editing PHP source for changes to take effect.
+opcache.validate_timestamps = 0
+
 # Windows
 #xdebug.mode = debug
 #xdebug.remote_host = host.docker.internal
