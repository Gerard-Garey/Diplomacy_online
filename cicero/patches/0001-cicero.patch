diff --git a/fairdiplomacy/utils/orders.py b/fairdiplomacy/utils/orders.py
index ea30d0e..2e3e598 100644
--- a/fairdiplomacy/utils/orders.py
+++ b/fairdiplomacy/utils/orders.py
@@ -4,9 +4,27 @@
 # This source code is licensed under the MIT license found in the
 # LICENSE file in the root directory of this source tree.
 #
+import re
+
 from fairdiplomacy.typedefs import Location, Order
 
 
+def normalize_order_spacing(order: Order) -> Order:
+    """Ensure canonical spacing around '-' in an order string.
+
+    LLM-generated orders routinely omit the spaces around the move dash (e.g.
+    "F TRI-ALB" instead of "F TRI - ALB"), which silently breaks every parser
+    in this file: get_unit_location() et al. all split on whitespace, so
+    "TRI-ALB" is read back as a single (bogus) location token instead of "TRI".
+    A malformed order like that then fails legality checks and is dropped --
+    not incorrectly, but for the wrong reason (a formatting slip, not an
+    actually-illegal or hallucinated order). Idempotent: already-canonical
+    strings pass through unchanged, so it is safe to apply unconditionally at
+    every LLM-output boundary.
+    """
+    return re.sub(r"(?<=\S)-(?=\S)", " - ", order.strip())
+
+
 def is_hold(order: Order) -> bool:
     pieces = order.split()
     return len(pieces) == 3 and pieces[2] == "H"
