+    ) -> Optional[PlausibleOrders]:
+        """Candidate action(s) realising `power`'s own negotiated commitments, if any.
+
+        Splices the promises onto the action this power currently intends, so the
+        engine evaluates "my plan, but honouring what I said" head-to-head against
+        its plan. Returns None when there is nothing to inject -- including on the
+        first search of a phase, where no negotiation has happened yet.
+        """
+        cfg = self.br_corr_bilateral_search_cfg
+        if cfg is None or not cfg.enable_pseudo_commitments:
+            return None
+
+        last = state.get_last_search_result(game)
+        if last is None:
+            return None
+        policy = last.get_agent_policy().get(power)
+        if not policy:
+            return None
+        base_action = max(policy, key=policy.get)
+
+        commitments = load_commitments(game.get_metadata("game_id"), game.current_short_phase)
+        extra = build_extra_plausible_actions(
+            game, power, base_action, commitments, cfg.pseudo_commitment_max_injected
+        )
