CICERO_COMMIT=e85afeddb34f5b7c1ea0827203b425a0f7e68ead
WEBDIP_DEPOT=https://github.com/kestasjk/webDiplomacy.git
WEBDIP_COMMIT=f5dffbe944c2d2c7b143946362cacbf486d03860
# Poids de modèle réellement chargés par conf/common/agents/cicero_no_dialogue.prototxt
# (le script d'amont en télécharge ~60 Go, dont 52 Go inutiles ici).
MODELES="blueprint.pt rl_search_orders.ckpt rl_value_function.ckpt cicero_imitation_bilateral_orders_prefix cicero_imitation_bilateral_orders_prefix.dict cicero_imitation_bilateral_orders_prefix.opt"
